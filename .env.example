# --- Fonte de preços ---------------------------------------------------------
# Padrão: fastflights (Google Flights ao vivo, sem cadastro). Nada a configurar.
PRICE_SOURCE=fastflights

# Alternativa: travelpayouts (precisa de conta de afiliado em travelpayouts.com)
# TRAVELPAYOUTS_TOKEN=seu_token
# TRAVELPAYOUTS_MARKER=seu_marker
# TRAVELPAYOUTS_USER_IP=127.0.0.1

# --- Telegram ---------------------------------------------------------------
# Crie um bot no @BotFather e mande /start pra ele.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Rode `python scripts/get_chat_id.py` pra descobrir.
TELEGRAM_CHAT_ID=123456789
# Chats que podem rodar comandos do bot (separados por vírgula). Default: TELEGRAM_CHAT_ID.
# TELEGRAM_ALLOWED_CHAT_IDS=-5497683237,123456789

# Caminho do SQLite (opcional; default data/history.db).
# MONITOR_DB_PATH=/caminho/history.db

# --- Webhook (só o runtime na VM, monitor.server — ver ADR-008) --------------
# URL pública completa do webhook, usada só pelo scripts/set_webhook.py.
# WEBHOOK_URL=https://167-234-239-28.sslip.io/webhook/flight-tg
# Segredo comparado com o header X-Telegram-Bot-Api-Secret-Token de cada POST.
# Gere algo aleatório, ex: `openssl rand -hex 24`.
# TELEGRAM_WEBHOOK_SECRET=troque_isto

# --- Backup (opcional — sem isso o backup diário só loga e pula) ------------
# URL de uma Pre-Authenticated Request de ESCRITA num bucket do OCI Object
# Storage (console OCI → bucket → Pre-Authenticated Requests → Create).
# OCI_BACKUP_PAR_URL=https://objectstorage.sa-saopaulo-1.oraclecloud.com/p/.../b/flight-price-monitor-backup/o
